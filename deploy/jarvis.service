# Linux nativo: core + edge no mesmo processo. Instalado por deploy/install-linux.sh.
[Unit]
Description=Jarvis — assistente pessoal por voz
After=pipewire.service pipewire-pulse.service graphical-session.target
Wants=pipewire.service

[Service]
ExecStart=%h/.local/share/jarvis/venv/bin/jarvis run
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
